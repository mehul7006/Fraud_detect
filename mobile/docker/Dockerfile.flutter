# Self-built Flutter + Android toolchain (fallback when pulling ghcr.io/cirruslabs/flutter fails).
# Build:  docker build -t fs-flutter -f mobile/docker/Dockerfile.flutter mobile/docker
# Use:    docker run --rm -v <mobile dir>:/work -w /work fs-flutter bash tool/setup_android.sh
FROM eclipse-temurin:17-jdk

ARG FLUTTER_VERSION=3.35.7
ARG ANDROID_CMDLINE=11076708

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl unzip xz-utils zip python3 ca-certificates libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

ENV FLUTTER_HOME=/opt/flutter \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PUB_CACHE=/root/.pub-cache
ENV PATH=$FLUTTER_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH

RUN git config --global --add safe.directory '*' \
 && git clone --depth 1 --branch ${FLUTTER_VERSION} https://github.com/flutter/flutter.git $FLUTTER_HOME

RUN mkdir -p $ANDROID_HOME/cmdline-tools \
 && curl -fsSL --retry 5 --retry-delay 3 -o /tmp/cmd.zip \
      https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE}_latest.zip \
 && unzip -q /tmp/cmd.zip -d $ANDROID_HOME/cmdline-tools \
 && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
 && rm /tmp/cmd.zip

RUN yes | sdkmanager --licenses > /dev/null \
 && sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0"

RUN flutter config --no-analytics \
 && flutter precache --android \
 && flutter --version
