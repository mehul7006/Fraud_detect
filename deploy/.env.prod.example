# FraudShield production settings. Copy to deploy/.env.prod (git-ignored) and fill in. Never commit real values.
# Full description of every secret: docs/SECRETS.md

# ---- server / HTTPS ----
DOMAIN=api.example.in
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- database (managed Postgres: use its host and require TLS) ----
DB_URL=jdbc:postgresql://<db-host>:5432/fraudshield?sslmode=require
DB_USER=
DB_PASSWORD=
# Only for `--profile localdb` (Postgres on the same server): the API reaches it as host "db"
# DB_URL=jdbc:postgresql://db:5432/fraudshield
# POSTGRES_DB=fraudshield

# ---- required secrets ----
# openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=

# ---- optional services (empty = off) ----
SAFE_BROWSING_KEY=
VT_ENABLED=true
VT_API_KEY=
ANTHROPIC_API_KEY=
# files inside KEYS_DIR, as seen by the container (/keys/...)
BLOCKLIST_SIGNING_KEY_FILE=/keys/blocklist-signing-key.pem
FIREBASE_CREDENTIALS_FILE=/keys/firebase-service-account.json
CORS_ALLOWED_ORIGINS=

# ---- host folders mounted into the API container ----
KEYS_DIR=./keys
BLOCKLISTS_DIR=./blocklists

# ---- backups (deploy/backup/pg_backup.sh) ----
BACKUP_DIR=/var/backups/fraudshield
BACKUP_RETENTION_DAYS=14
# optional off-site copy to S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, ...)
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# ---- monitoring (deploy/monitor/check.sh) ----
# Slack incoming webhook, or Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat id>
ALERT_WEBHOOK_URL=
